{
  "expo": {
    "name": "WakaDash",
    "slug": "wakatime-dashboard",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "newArchEnabled": false,
    "plugins": [
      "expo-secure-store",
      "expo-router",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "TodayPill",
              "label": "Today's total time",
              "minWidth": "120dp",
              "minHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "scheme": "wakatime-dashboard",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7edf8f0b-70e2-4344-bc42-38378e220123"
      }
    },
    "android": {
      "package": "com.infinotiver.wakadash"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7edf8f0b-70e2-4344-bc42-38378e220123"
    }
  }
}
