{
  "expo": {
    "name": "WakaDash",
    "slug": "wakatime-dashboard",
    "version": "1.3.1",
    "orientation": "portrait",
    "icon": "assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "newArchEnabled": false,
    "plugins": [
      "expo-secure-store",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#232323",
          "image": "./assets/icon-512.png",
          "dark": {
            "image": "./assets/icon-512.png",
            "backgroundColor": "#000000"
          },
          "imageWidth": 200
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "TodayPill",
              "label": "Today's total time",
              "description": "Today's coding time at a glance",
              "minWidth": "109dp",
              "minHeight": "56dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "TopBreakdown",
              "label": "Top languages, projects & OS",
              "description": "Your top languages, projects and systems",
              "minWidth": "245dp",
              "minHeight": "115dp",
              "maxResizeWidth": "624dp",
              "maxResizeHeight": "276dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "scheme": "wakatime-dashboard",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7edf8f0b-70e2-4344-bc42-38378e220123"
      }
    },
    "android": {
      "package": "com.infinotiver.wakadash"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7edf8f0b-70e2-4344-bc42-38378e220123"
    }
  }
}
