{
  "expo": {
    "name": "WakaDash",
    "slug": "wakatime-dashboard",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/icons/icon.png",
    "android": {
      "package": "com.infinotiver.wakadash",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-icon-foreground.png",
        "monochromeImage": "./assets/icons/adaptive-icon-monochrome.png",
        "backgroundColor": "#1b1b1b"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_SPECIAL_USE",
        "android.permission.PACKAGE_USAGE_STATS",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#232323",
          "image": "./assets/icons/icon.png",
          "dark": {
            "image": "./assets/icons/icon.png",
            "backgroundColor": "#000000"
          },
          "imageWidth": 200
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "TodayPill",
              "label": "Today's total time",
              "description": "Today's coding time at a glance",
              "minWidth": "109dp",
              "minHeight": "56dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "TopBreakdown",
              "label": "Top languages, projects & OS",
              "description": "Your top languages, projects and systems",
              "minWidth": "245dp",
              "minHeight": "115dp",
              "maxResizeWidth": "624dp",
              "maxResizeHeight": "276dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/notification.png",
          "color": "#006874"
        }
      ],
      "expo-font"
    ],
    "scheme": "wakadash",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7edf8f0b-70e2-4344-bc42-38378e220123"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7edf8f0b-70e2-4344-bc42-38378e220123"
    }
  }
}
